# Copy this file to pipeline/.env.r2.local and fill in real values yourself
# (in your editor, not via chat). pipeline/.env.r2.local is already covered by
# the ".env.*.local" rule in .gitignore, so it will never be committed, and
# Claude will only `source` it in a subshell - never read or print its
# contents - so the values stay out of the conversation transcript.

R2_ACCOUNT_ID=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
