VITE_MAPTILER_API_KEY=
# Optional in development. Set this to the public R2 latest.json URL in Netlify.
VITE_SNOW_MANIFEST_URL=
# Optional. A URL-restricted Mapbox *public* token for the A-to-B route planner
# (spec section 8). Never the account's default token: Mapbox does not apply URL
# restrictions to default tokens. Unset means the route planner reports itself
# unavailable - there is no fallback provider.
VITE_MAPBOX_TOKEN=
